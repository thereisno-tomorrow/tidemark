{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "status", "releaseId", "planId", "installedAt", "targets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["verified-provisional", "active", "active-local", "rolled-back", "rollback-conflict"]},
    "releaseId": {"type": "string"},
    "planId": {"type": "string"},
    "installedAt": {"type": "string"},
    "targets": {"type": "array", "items": {"type": "object"}}
  }
}
